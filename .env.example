# ─────────────────────────────────────────────────────────────────────────
#  auto-instargram 환경변수 예시
#
#  ▶ 보통은 직접 만들 필요가 없습니다 — `run.bat`(Windows) / `./run.sh`(mac·Linux) 가
#     이 파일을 바탕으로 `.env` 를 만들고 비밀값을 무작위로 생성해 채웁니다.
#
#  ▶ 직접 만들려면: 이 파일을 `.env` 로 복사한 뒤
#     아래 `EXAMPLE_ONLY_...` 로 표시된 값을 반드시 실제 값으로 바꾸세요.
#     ⚠️ 그대로 두면 서버가 시작을 거부합니다 (유효한 형식이 아니기 때문입니다 — 의도된 동작).
#      Windows:  copy .env.example .env
#      mac/Linux: cp .env.example .env
#
#  ▶ `.env` 는 .gitignore 로 제외되어 커밋되지 않습니다.
#     (SKL-SECRETS-MANAGEMENT 규칙 2: 버전 관리에는 예시 값만 둔다)
#  ▶ 아래 값들은 전부 "예시"입니다. 실제 운영에서는 반드시 교체하세요.
# ─────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (docker-compose.dev.yml 이 읽음) ──────────────────────────
POSTGRES_DB=auto_instargram
POSTGRES_USER=auto_instargram
# 로컬 개발용 예시 비밀번호입니다. 운영에서는 반드시 교체하세요.
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# ── Backend: 3_architecture.md SVC-02 의 Required env vars ───────────────
# DATABASE_URL — JDBC 형식. 위 POSTGRES_* 값과 일치시켜야 합니다.
DATABASE_URL=jdbc:postgresql://localhost:5432/auto_instargram
DATABASE_USERNAME=auto_instargram
DATABASE_PASSWORD=change_me_local_only

# JWT_SECRET — 대시보드 로그인 토큰 서명 키.
#   HS256 기준 최소 32바이트(256비트) 이상이어야 하며, 짧으면 서버가 시작을 거부합니다.
#   새 값 생성 예:  openssl rand -base64 48
JWT_SECRET=EXAMPLE_ONLY_replace_me_with_a_random_48_byte_base64_secret_value

# INSTAGRAM_ACCESS_TOKEN — Meta Instagram Graph API 액세스 토큰.
#   POL-05: 이 값은 로그·에러 메시지에 절대 출력되지 않습니다.
#   비워 두면 인스타그램 실제 연동만 비활성화되고, 나머지 기능은 정상 동작합니다.
INSTAGRAM_ACCESS_TOKEN=

# INSTAGRAM_CLIENT_SECRET — 단기→장기 토큰 교환(POST /api/v1/tokens/refresh)에 필요한 앱 시크릿.
#   Meta 개발자 콘솔의 앱 설정에서 발급받습니다.
#   비워 두면 토큰 교환 API 만 "설정 없음" 오류를 반환하고, 나머지 기능은 정상 동작합니다.
INSTAGRAM_CLIENT_SECRET=

# CREDENTIAL_ENCRYPTION_KEY — 인스타그램 토큰을 DB 에 암호화 저장할 때 쓰는 키 (AES-256).
#   base64 로 인코딩된 정확히 32바이트여야 하며, 아니면 서버가 시작을 거부합니다.
#   새 값 생성 예:  openssl rand -base64 32
#   ⚠️ 이 키를 잃으면 저장된 토큰을 복호화할 수 없습니다. 키를 바꾸면 토큰을 다시 발급해야 합니다.
CREDENTIAL_ENCRYPTION_KEY=EXAMPLE_ONLY_replace_me_with_openssl_rand_base64_32==

# JWT_COOKIE_SECURE — 인증 쿠키에 Secure 속성을 붙일지.
#   로컬 개발(http://localhost)에서는 false 여야 브라우저가 쿠키를 보냅니다.
#   ⚠️ HTTPS 로 운영할 때는 반드시 true 로 바꾸세요.
JWT_COOKIE_SECURE=false

# MEDIA_BASE_DIR — 업로드할 영상 파일을 두는 디렉터리.
#   보안상 예약·업로드 요청은 이 디렉터리 안의 파일만 가리킬 수 있습니다.
#   (밖을 가리키는 경로는 거부됩니다 — 서버의 다른 파일을 읽어 가는 공격 차단)
#   BE 폴더 기준 상대 경로이며, 없으면 서버가 자동으로 만듭니다.
MEDIA_BASE_DIR=./storage/media

# INSTAGRAM_PUBLISH_ENABLED — 인스타그램에 실제로 게시할지 여부.
#   false 이면: 파일 검증·작업 등록·이력 기록까지 모두 정상 동작하고,
#              마지막 "실제 게시" 단계만 "미구성" 오류로 중단합니다.
#   true 로 바꾸려면 아래 INSTAGRAM_USER_ID 와 유효한 액세스 토큰이 함께 필요합니다.
#   ⚠️ true 로 두면 실제로 인스타그램에 게시물이 올라갑니다.
INSTAGRAM_PUBLISH_ENABLED=false

# INSTAGRAM_USER_ID — 게시 대상 인스타그램 비즈니스 계정 ID (숫자).
INSTAGRAM_USER_ID=

# PUBLISH_WORKER_ENABLED — 예약된 발행을 자동으로 실행하는 백그라운드 작업 사용 여부.
#   false 로 두면 예약이 등록만 되고 실행되지 않습니다.
PUBLISH_WORKER_ENABLED=true

# ── 초기 로그인 계정 (서버가 처음 뜰 때 없으면 자동 생성) ──────────────────
#   이미 있는 계정은 건드리지 않습니다(비밀번호도 덮어쓰지 않음).
#   ⚠️ 아래는 로컬 개발용 예시 비밀번호입니다. 운영에서는 반드시 바꾸세요.
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin!2026Local
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=Operator!2026Local

# ── Backend 서버 포트 (3_architecture.md SVC-02 Port: 8080) ──────────────
SERVER_PORT=8080

# ── Frontend (3_architecture.md SVC-01 은 Port 를 0 으로 두어 미지정 →
#     Vite 표준 개발 포트 5173 을 사용합니다) ─────────────────────────────
FE_PORT=5173
# 브라우저에서 백엔드를 호출할 주소. Vite 는 VITE_ 접두사만 노출합니다.
VITE_API_BASE_URL=http://localhost:8080

# ── CORS: 백엔드가 허용할 프론트엔드 출처 (Phase 5) ───────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
